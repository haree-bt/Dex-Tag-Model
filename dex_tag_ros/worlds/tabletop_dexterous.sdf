<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tabletop_dexterous">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Studio Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Workspace Table -->
    <model name="work_table">
      <static>true</static>
      <pose>0.4 0 0.2 0 0 0</pose>
      <link name="table_link">
        <collision name="top_col">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.7 1.0 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="top_vis">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.7 1.0 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Target Tool with Multi-Finger Contact Zones -->
    <model name="industrial_target">
      <static>false</static>
      <pose>0.4 0 0.42 0 0 0.52</pose>
      <link name="tool_link">
        <inertial>
          <mass>0.28</mass>
          <inertia><ixx>0.0006</ixx><iyy>0.0009</iyy><izz>0.0009</izz></inertia>
        </inertial>
        <!-- Blue Cylindrical Handle: Tripod / Power Contact Zone -->
        <visual name="handle_vis">
          <pose>-0.05 0 0 0 1.5707963 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.13</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.15 0.5 0.95 1</diffuse></material>
        </visual>
        <collision name="handle_col">
          <pose>-0.05 0 0 0 1.5707963 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.13</length></cylinder></geometry>
          <surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface>
        </collision>

        <!-- Orange Functional Working Tip: Precision Pinch Tool Zone -->
        <visual name="tip_vis">
          <pose>0.055 0 0 0 0 0</pose>
          <geometry><box><size>0.08 0.04 0.02</size></box></geometry>
          <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.95 0.35 0.1 1</diffuse></material>
        </visual>
        <collision name="tip_col">
          <pose>0.055 0 0 0 0 0</pose>
          <geometry><box><size>0.08 0.04 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Calibrated Overhead RGB-D Perception Camera -->
    <model name="overhead_rgbd_camera">
      <static>true</static>
      <pose>0.4 0 1.05 0 1.5707963 0</pose>
      <link name="camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
            <depth_camera><clip><near>0.1</near><far>3.0</far></clip></depth_camera>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/camera</topic>
        </sensor>
      </link>
    </model>
    <!-- 6-DoF Articulated Robotic Manipulator with Dexterous 3-Finger Hand -->
    <model name="robotic_manipulator">
      <static>true</static>
      <pose>0.15 0 0.40 0 0 0</pose>
      
      <!-- Base Mount -->
      <link name="arm_base">
        <visual name="base_vis">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
      
      <!-- Shoulder Link -->
      <link name="shoulder_link">
        <pose>0 0 0.11 0 0 0</pose>
        <visual name="shoulder_vis">
          <geometry><cylinder><radius>0.055</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>

      <!-- Upper Arm Link reaching forward and up -->
      <link name="upper_arm_link">
        <pose>0.07 0 0.22 0 0.65 0</pose>
        <visual name="upper_arm_vis">
          <geometry><cylinder><radius>0.042</radius><length>0.26</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.75 0.8 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>

      <!-- Forearm Link reaching toward target tool -->
      <link name="forearm_link">
        <pose>0.18 0 0.20 0 -0.85 0</pose>
        <visual name="forearm_vis">
          <geometry><cylinder><radius>0.038</radius><length>0.22</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.75 0.8 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>

      <!-- Wrist Link -->
      <link name="wrist_link">
        <pose>0.24 0 0.13 0 0 0</pose>
        <visual name="wrist_vis">
          <geometry><cylinder><radius>0.032</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>

      <!-- Dexterous Hand Palm -->
      <link name="hand_palm">
        <pose>0.25 0 0.08 0 0 0</pose>
        <visual name="palm_vis">
          <geometry><box><size>0.05 0.08 0.03</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- Multi-Finger Dexterous Contacts (Tripod Grip Mode) -->
      <!-- Thumb (Opposing Contact Pad) -->
      <link name="finger_thumb">
        <pose>0.23 0 0.035 0 0.25 0</pose>
        <visual name="thumb_vis">
          <geometry><cylinder><radius>0.007</radius><length>0.045</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.95 0.45 0.1 1</diffuse></material>
        </visual>
      </link>
      <!-- Index Finger -->
      <link name="finger_index">
        <pose>0.28 -0.022 0.035 0 -0.25 0</pose>
        <visual name="index_vis">
          <geometry><cylinder><radius>0.007</radius><length>0.045</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.95 0.45 0.1 1</diffuse></material>
        </visual>
      </link>
      <!-- Middle Finger -->
      <link name="finger_middle">
        <pose>0.28 0.022 0.035 0 -0.25 0</pose>
        <visual name="middle_vis">
          <geometry><cylinder><radius>0.007</radius><length>0.045</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.95 0.45 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
