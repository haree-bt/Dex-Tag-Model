<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tabletop_dexterous">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Studio Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Workspace Table -->
    <model name="work_table">
      <static>true</static>
      <pose>0.4 0 0.2 0 0 0</pose>
      <link name="table_link">
        <collision name="top_col">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.7 1.0 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="top_vis">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.7 1.0 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Target Tool with Multi-Finger Contact Zones -->
    <model name="industrial_target">
      <static>false</static>
      <pose>0.4 0 0.42 0 0 0.52</pose>
      <link name="tool_link">
        <inertial>
          <mass>0.28</mass>
          <inertia><ixx>0.0006</ixx><iyy>0.0009</iyy><izz>0.0009</izz></inertia>
        </inertial>
        <!-- Blue Cylindrical Handle: Tripod / Power Contact Zone -->
        <visual name="handle_vis">
          <pose>-0.05 0 0 0 1.5707963 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.13</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.15 0.5 0.95 1</diffuse></material>
        </visual>
        <collision name="handle_col">
          <pose>-0.05 0 0 0 1.5707963 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.13</length></cylinder></geometry>
          <surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface>
        </collision>

        <!-- Orange Functional Working Tip: Precision Pinch Tool Zone -->
        <visual name="tip_vis">
          <pose>0.055 0 0 0 0 0</pose>
          <geometry><box><size>0.08 0.04 0.02</size></box></geometry>
          <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.95 0.35 0.1 1</diffuse></material>
        </visual>
        <collision name="tip_col">
          <pose>0.055 0 0 0 0 0</pose>
          <geometry><box><size>0.08 0.04 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Calibrated Overhead RGB-D Perception Camera -->
    <model name="overhead_rgbd_camera">
      <static>true</static>
      <pose>0.4 0 1.05 0 1.5707963 0</pose>
      <link name="camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
            <depth_camera><clip><near>0.1</near><far>3.0</far></clip></depth_camera>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/camera</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
